{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "FAST Realtime Update",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/fast_realtime_update.py",
            "console": "integratedTerminal",
            "args": [
                "-c",
                "${workspaceFolder}/src/config_realtime.ini",
                "-r",
                "False"
            ]
        },
        {
            "name": "FAST Realtime Merged",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/fast_realtime_update2.py",
            "console": "integratedTerminal",
            "args": [
                "-c",
                "${workspaceFolder}/src/config_FULL_hand_liux_v2.ini",
                "--nwm",
                "--quiet"
            ]
        },
        {
            "name": "FAST Realtime Batch NWM",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/fast_realtime_batch.py",
            "console": "integratedTerminal",
            "args": [
                "-f",
                "${workspaceFolder}/src/txdot_dist_local_nwm",
                "-r",
                "False"
            ]
        },
        {
            "name": "FAST Realtime Batch DA",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/fast_realtime_batch.py",
            "console": "integratedTerminal",
            "args": [
                "-f",
                "${workspaceFolder}/src/txdot_dist_local_da",
                "-r",
                "False"
            ]
        },
        {
            "name": "Run FastAPI (main.py)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--host", "0.0.0.0",
                "--port", "8000"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "jinja": true,
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}